---
/**
 * Fact table with explicit boundary columns: a documented fact, what it is,
 * and what it is not. Renders as a three-column table on desktop and stacked
 * fact records on mobile (same values, no horizontal dragging). Reuses the
 * site's existing fact-table / fact-record CSS.
 */
interface Fact {
  value: string;
  is: string;
  isNot: string;
}

interface Props {
  facts: Fact[];
  caption: string;
}

const { facts, caption } = Astro.props;
---

<div class="hidden md:block overflow-x-auto">
  <table class="fact-table">
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">Fact</th>
        <th scope="col">What it is</th>
        <th scope="col">What it is not</th>
      </tr>
    </thead>
    <tbody>
      {
        facts.map((f) => (
          <tr>
            <td><strong>{f.value}</strong></td>
            <td>{f.is}</td>
            <td>{f.isNot}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<div class="md:hidden mt-6">
  <p class="font-mono text-[0.62rem] uppercase tracking-[0.08em] text-[var(--color-text-muted)] mb-2">
    {caption}
  </p>
  <div class="border-t border-[var(--color-rule-light)]">
    {
      facts.map((f) => (
        <div class="fact-record">
          <p class="fact-record-value">{f.value}</p>
          <p class="fact-record-row">
            <span class="fact-record-label">What it is</span>
            {f.is}
          </p>
          <p class="fact-record-row">
            <span class="fact-record-label">What it is not</span>
            {f.isNot}
          </p>
        </div>
      ))
    }
  </div>
</div>
