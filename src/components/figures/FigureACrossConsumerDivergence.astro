---
/**
 * Figure A — Cross-Consumer Enforcement Divergence.
 *
 * Rendered from authority_enforcement_presentation_design_v01/
 * FIGURE_A_CROSS_CONSUMER_DIVERGENCE_SPEC.md.
 *
 * Claim-bearing invariants enforced here (do not "tidy" them away):
 *   1. There is exactly ONE canonical decision object (Layer 2).
 *   2. The raw/audit path connects from Layer 1 (the state), NOT from Layer 2.
 *   3. The raw/audit path is labelled NOT A BEHAVIORAL CONSUMER and is neutral.
 *   4. "Observed on one audited substrate." is always visible.
 *   5. No arrow leads into a model, host, action, or output box.
 *   6. No lock, shield, gradient, or decorative AI imagery.
 *
 * Two SVG variants are emitted (desktop lanes / mobile stack) because SVG text
 * does not wrap: a single 1120px-wide diagram scaled to 350px would render
 * 11px labels at ~3px. Both variants carry the same content; the hidden one is
 * removed from the accessibility tree by `display:none` at its breakpoint.
 *
 * Colour is never the only channel: solid vs dashed connectors, filled EXPOSE
 * badge vs outlined badges, and explicit text labels all survive greyscale.
 */

const SANS = 'Inter, system-ui, -apple-system, sans-serif';
const MONO = "'JetBrains Mono', ui-monospace, monospace";

const altText =
  'One governed persistent state S, whose authority status is NOT APPROVED, is ' +
  'the input to one canonical authority decision, A(S) = NOT BEHAVIORALLY ELIGIBLE. ' +
  'Two behavioral consumer paths receive that decision and disagree: Behavioral ' +
  'Consumer A returns BLOCK and honors A(S); Behavioral Consumer B returns EXPOSE ' +
  'and does not consult A(S). Same decision, different behavioral enforcement, ' +
  'observed as two disagreeing consumer pairs under the unapproved condition. ' +
  'A separate raw/audit observer reads the state directly rather than the decision, ' +
  'returns VISIBLE, and is explicitly NOT A BEHAVIORAL CONSUMER: visibility only, ' +
  'no behavioral eligibility. Observed on one audited substrate. Measured at ' +
  'construction and emission of behavioral context; no downstream model behavior ' +
  'was measured.';
---

<figure class="figure-a not-prose" role="group" aria-labelledby="figure-a-title">
  <figcaption id="figure-a-title" class="fig-title">
    Figure A — Cross-consumer enforcement divergence
  </figcaption>

  <!-- ================= DESKTOP ================= -->
  <svg
    class="fig-a-svg fig-a-desktop"
    viewBox="0 0 1120 660"
    role="img"
    aria-label={altText}
    xmlns="http://www.w3.org/2000/svg"
  >
    <title>Cross-consumer enforcement divergence — systems diagram</title>
    <desc>{altText}</desc>

    <defs>
      <marker id="figa-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0,1 L7,4 L0,7 z" fill="var(--color-text-muted, #7c786f)" />
      </marker>
      <marker id="figa-arrow-dashed" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
        <path d="M0,1 L7,4 L0,7 z" fill="var(--color-text-muted, #7c786f)" />
      </marker>
    </defs>

    <g font-family={SANS}>

      <!-- ---------- Layer 1 — Governed state ---------- -->
      <rect x="370" y="32" width="380" height="96" rx="8"
            fill="var(--color-page-warm, #f5efe4)" stroke="var(--color-rule, #ddd6ca)" stroke-width="2" />
      <text x="560" y="66" text-anchor="middle" font-size="17" font-weight="600"
            fill="var(--color-ink, #20262d)">Persistent State S</text>
      <text x="560" y="88" text-anchor="middle" font-size="11.5" font-family={MONO}
            fill="var(--color-text-dim, #5d5b55)">state exists · authority status: NOT APPROVED</text>
      <text x="560" y="106" text-anchor="middle" font-size="11" font-family={MONO}
            fill="var(--color-text-muted, #7c786f)">S = correction::javascript::…</text>

      <!-- state → decision -->
      <line x1="560" y1="128" x2="560" y2="164" stroke="var(--color-text-muted, #7c786f)"
            stroke-width="1.5" marker-end="url(#figa-arrow)" />

      <!-- ---------- Layer 2 — Canonical authority decision ---------- -->
      <rect x="330" y="168" width="460" height="88" rx="3"
            fill="var(--color-surface, #ffffff)" stroke="var(--color-ink, #20262d)" stroke-width="2" />
      <!-- double vertical rule: the token for "single canonical source" -->
      <line x1="336" y1="176" x2="336" y2="248" stroke="var(--color-ink, #20262d)" stroke-width="2" />
      <line x1="341" y1="176" x2="341" y2="248" stroke="var(--color-ink, #20262d)" stroke-width="2" />

      <text x="560" y="206" text-anchor="middle" font-size="16" font-weight="600" font-family={MONO}
            fill="var(--color-ink, #20262d)">A(S) = NOT BEHAVIORALLY ELIGIBLE</text>
      <text x="560" y="230" text-anchor="middle" font-size="11" font-family={MONO}
            fill="var(--color-text-dim, #5d5b55)">one canonical decision · fail-closed</text>
      <text x="560" y="276" text-anchor="middle" font-size="12" font-style="italic"
            fill="var(--color-text-muted, #7c786f)">One decision. One source. Not one enforcement outcome.</text>

      <!-- ---------- Layer 3 — lane headers + divider ---------- -->
      <text x="56" y="306" font-size="11" font-weight="600" font-family={MONO}
            fill="var(--color-brand, #183b56)" letter-spacing="0.08em">BEHAVIORAL CONSUMERS</text>
      <text x="736" y="306" font-size="11" font-weight="600" font-family={MONO}
            fill="var(--color-text-muted, #7c786f)" letter-spacing="0.08em">RAW / AUDIT OBSERVER</text>
      <line x1="716" y1="296" x2="716" y2="486" stroke="var(--color-rule, #ddd6ca)" stroke-width="1" />

      <!-- decision → behavioral consumer A -->
      <path d="M560,256 V296 H116 V316" fill="none" stroke="var(--color-text-muted, #7c786f)"
            stroke-width="1.5" marker-end="url(#figa-arrow)" />
      <!-- decision → behavioral consumer B -->
      <path d="M560,256 V296 H461 V316" fill="none" stroke="var(--color-text-muted, #7c786f)"
            stroke-width="1.5" marker-end="url(#figa-arrow)" />
      <!-- state → raw/audit observer (DASHED; originates at the STATE, not the decision) -->
      <path d="M800,80 H900 V316" fill="none" stroke="var(--color-text-muted, #7c786f)"
            stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#figa-arrow-dashed)" />
      <text x="908" y="300" font-size="10" font-family={MONO}
            fill="var(--color-text-muted, #7c786f)">reads state, not A(S)</text>

      <!-- ---------- Path 1 — Behavioral Consumer A ---------- -->
      <rect x="56" y="320" width="300" height="160" rx="6"
            fill="var(--color-surface, #ffffff)" stroke="var(--color-rule-light, #eae4d9)" stroke-width="1.5" />
      <text x="72" y="346" font-size="13.5" font-weight="600" fill="var(--color-ink, #20262d)">Behavioral Consumer A</text>
      <text x="72" y="364" font-size="11.5" fill="var(--color-text-dim, #5d5b55)">behavioral context constructor</text>
      <rect x="72" y="378" width="88" height="30" rx="15"
            fill="var(--color-surface, #ffffff)" stroke="var(--color-secondary, #2e6f63)" stroke-width="1.5" />
      <text x="116" y="398" text-anchor="middle" font-size="12.5" font-weight="600" font-family={MONO}
            fill="var(--color-secondary-dim, #235448)">BLOCK</text>
      <text x="72" y="430" font-size="11.5" font-family={MONO} fill="var(--color-text-dim, #5d5b55)">honors A(S)</text>

      <!-- ---------- Path 2 — Behavioral Consumer B ---------- -->
      <rect x="396" y="320" width="300" height="160" rx="6"
            fill="var(--color-surface, #ffffff)" stroke="var(--color-rule-light, #eae4d9)" stroke-width="1.5" />
      <text x="412" y="346" font-size="13.5" font-weight="600" fill="var(--color-ink, #20262d)">Behavioral Consumer B</text>
      <text x="412" y="364" font-size="11.5" fill="var(--color-text-dim, #5d5b55)">behavioral context constructor — different code path</text>
      <rect x="412" y="378" width="98" height="30" rx="15"
            fill="var(--color-primary, #a8522d)" stroke="var(--color-primary, #a8522d)" stroke-width="1.5" />
      <text x="461" y="398" text-anchor="middle" font-size="12.5" font-weight="600" font-family={MONO}
            fill="#ffffff">EXPOSE</text>
      <text x="412" y="430" font-size="11.5" font-family={MONO} fill="var(--color-text-dim, #5d5b55)">does not consult A(S)</text>

      <!-- ---------- Path 3 — Raw / Audit Observer ---------- -->
      <rect x="736" y="320" width="328" height="160" rx="6"
            fill="var(--color-surface, #ffffff)" stroke="var(--color-rule-light, #eae4d9)" stroke-width="1.5" />
      <text x="752" y="346" font-size="13.5" font-weight="600" fill="var(--color-ink, #20262d)">Raw / Audit Observer</text>
      <text x="752" y="364" font-size="11.5" fill="var(--color-text-muted, #7c786f)">inspection path</text>
      <rect x="752" y="378" width="92" height="30" rx="15"
            fill="var(--color-surface, #ffffff)" stroke="var(--color-text-muted, #7c786f)"
            stroke-width="1.5" stroke-dasharray="4 3" />
      <text x="798" y="398" text-anchor="middle" font-size="12.5" font-weight="600" font-family={MONO}
            fill="var(--color-text-dim, #5d5b55)">VISIBLE</text>
      <text x="752" y="430" font-size="11" font-weight="600" font-family={MONO}
            fill="var(--color-text-dim, #5d5b55)">NOT A BEHAVIORAL CONSUMER</text>
      <text x="752" y="448" font-size="11" font-family={MONO}
            fill="var(--color-text-muted, #7c786f)">visibility only — no behavioral eligibility</text>
      <text x="900" y="496" text-anchor="middle" font-size="10" font-family={MONO}
            fill="var(--color-text-muted, #7c786f)">inspection · not behavioral exposure</text>

      <!-- ---------- Layer 4 — Divergence marker (spans Paths 1–2 only) ---------- -->
      <path d="M56,500 V508 H696 V500" fill="none" stroke="var(--color-primary, #a8522d)" stroke-width="2" />
      <circle cx="376" cy="508" r="14" fill="var(--color-page, #faf6ef)"
              stroke="var(--color-primary, #a8522d)" stroke-width="2" />
      <text x="376" y="514" text-anchor="middle" font-size="16" font-family={MONO}
            fill="var(--color-primary, #a8522d)">≠</text>
      <text x="376" y="546" text-anchor="middle" font-size="14.5" font-weight="600"
            fill="var(--color-primary, #a8522d)">Same decision → different behavioral enforcement</text>
      <text x="376" y="566" text-anchor="middle" font-size="11" font-family={MONO}
            fill="var(--color-text-muted, #7c786f)">2 disagreeing consumer pairs (unapproved condition)</text>

      <!-- ---------- Boundary note (mandatory) ---------- -->
      <text x="560" y="596" text-anchor="middle" font-size="12" font-weight="600" font-family={MONO}
            fill="var(--color-text-dim, #5d5b55)">Observed on one audited substrate.</text>
      <text x="560" y="614" text-anchor="middle" font-size="10.5" font-family={MONO}
            fill="var(--color-text-muted, #7c786f)">Measured at construction and emission of behavioral context. No downstream model behavior measured.</text>

      <text x="56" y="640" font-size="10.5" font-family={MONO}
            fill="var(--color-text-muted, #7c786f)">substrate: IJFW v1.6.5 · audited release</text>
    </g>
  </svg>

  <!-- ================= MOBILE (stacked lanes) ================= -->
