      <line x1="20" y1="132" x2="20" y2="196" stroke="var(--color-ink, #20262d)" stroke-width="2" />
      <line x1="24" y1="132" x2="24" y2="196" stroke="var(--color-ink, #20262d)" stroke-width="2" />
      <text x="180" y="158" text-anchor="middle" font-size="13" font-weight="600" font-family={MONO}
            fill="var(--color-ink, #20262d)">A(S) = NOT BEHAVIORALLY ELIGIBLE</text>
      <text x="180" y="178" text-anchor="middle" font-size="9.5" font-family={MONO}
            fill="var(--color-text-dim, #5d5b55)">one canonical decision · fail-closed</text>
      <text x="180" y="220" text-anchor="middle" font-size="10.5" font-style="italic"
