      <path d="M14,58 H7 V700 H12" fill="none" stroke="var(--color-text-muted, #7c786f)"
            stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#figa-arrow-m)" />

      <text x="14" y="250" font-size="10" font-weight="600" font-family={MONO}
            fill="var(--color-brand, #183b56)" letter-spacing="0.08em">BEHAVIORAL CONSUMERS</text>

      <!-- Path A -->
      <rect x="14" y="258" width="332" height="112" rx="6"
            fill="var(--color-surface, #ffffff)" stroke="var(--color-rule-light, #eae4d9)" stroke-width="1.5" />
      <text x="28" y="282" font-size="12.5" font-weight="600" fill="var(--color-ink, #20262d)">Behavioral Consumer A</text>
      <text x="28" y="298" font-size="10.5" fill="var(--color-text-dim, #5d5b55)">behavioral context constructor</text>
      <rect x="28" y="308" width="76" height="26" rx="13"
            fill="var(--color-surface, #ffffff)" stroke="var(--color-secondary, #2e6f63)" stroke-width="1.5" />
      <text x="66" y="326" text-anchor="middle" font-size="11" font-weight="600" font-family={MONO}
            fill="var(--color-secondary-dim, #235448)">BLOCK</text>
      <text x="28" y="356" font-size="10" font-family={MONO} fill="var(--color-text-dim, #5d5b55)">honors A(S)</text>

