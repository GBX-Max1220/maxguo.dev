---
import records from '../data/contributions.json';
import { groupByDay, storyEvents, EVENT_LABELS, formatDay } from '../lib/contributions.mjs';
import ContributionStatus from './ContributionStatus.astro';
---
<div class="space-y-10">
  {groupByDay(records).map(({ day, entries }) => <section aria-labelledby={`date-${day}`}>
    <h2 id={`date-${day}`} class="text-xl mb-4"><time datetime={day}>{formatDay(day)}</time></h2>
    <div class="space-y-4">
      {entries.map(record => {
        const related = storyEvents(record, records).filter(event => event.id !== record.id);
        return <article id={record.id} data-contribution-id={record.id} class="card-static min-w-0 scroll-mt-20">
          <p class="text-xs text-[var(--color-text-muted)] mb-2">{record.project} · {EVENT_LABELS[record.event]} <time datetime={record.occurredAt}>{formatDay(record.localDate)}</time></p>
          <h3 class="text-lg mb-2 break-words"><a href={record.url}>{record.title}</a></h3>
          <ContributionStatus record={record} />
          <p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-2">{record.contribution}</p>
          <p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-3">{record.whyItMatters}</p>
          <a href={record.url} class="link-arrow">Public evidence →</a>
          {related.length > 0 && <div class="mt-3 text-xs text-[var(--color-text-muted)]">
            <p class="mb-1">In this contribution story</p>
            <ul class="flex flex-wrap gap-x-4 gap-y-2">{related.map(event => <li><a href={`#${event.id}`}>{EVENT_LABELS[event.event]} · {formatDay(event.localDate)}</a></li>)}</ul>
          </div>}
        </article>;
      })}
    </div>
  </section>)}
</div>
