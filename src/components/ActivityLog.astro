---
import records from '../data/contributions.json';
import { newestFirst, EVENT_LABELS, formatDay, statusLabel } from '../lib/contributions.mjs';
const recent = newestFirst(records).slice(0, 4);
---
<ol class="contribution-recent">
  {recent.map((record, index) => {
    const dayAlreadyShown = index > 0 && recent[index - 1].localDate === record.localDate;
    return <li class="contribution-recent-item">
      <time class:list={["contribution-recent-date", dayAlreadyShown && "sr-only"]} datetime={record.localDate} aria-label={formatDay(record.localDate)}>{formatDay(record.localDate)}</time>
      <div class="contribution-recent-detail">
        <p class="contribution-recent-meta">{record.project} · {EVENT_LABELS[record.event]} · {statusLabel(record)}</p>
        <a href={`/contributions/#${record.id}`} class="contribution-recent-link">{record.title}</a>
      </div>
    </li>;
  })}
</ol>
