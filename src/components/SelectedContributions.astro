---
import records from '../data/contributions.json';
import { selectedContributions, storyEvents, EVENT_LABELS, formatDay } from '../lib/contributions.mjs';
import ContributionStatus from './ContributionStatus.astro';
---
<section id="contributions" class="mb-14">
  <span class="section-kicker">Public evidence</span>
  <h2 class="mt-2 mb-5">Selected Research &amp; Engineering Contributions</h2>
  <div class="space-y-4">
    {selectedContributions(records).map(record => {
      const story = storyEvents(record, records);
      return <article data-selected-id={record.id} class="card-static min-w-0">
        <p class="text-xs text-[var(--color-text-muted)] mb-2">{record.project}</p>
        <h3 class="text-[1.1rem] mb-2 break-words"><a href={record.url}>{record.title}</a></h3>
        <ContributionStatus record={record} />
        <p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-3">{record.contribution}</p>
        <a href={record.url} class="link-arrow">Public evidence →</a>
        {story.length > 1 && <ol class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-xs text-[var(--color-text-muted)]" aria-label={`${record.project} contribution story`}>
          {story.map(event => <li><a href={`/contributions/#${event.id}`}>{EVENT_LABELS[event.event]} · {formatDay(event.localDate)}</a></li>)}
        </ol>}
      </article>;
    })}
  </div>
  <a href="/contributions/" class="link-arrow mt-5">Research Engineering Log →</a>
</section>
