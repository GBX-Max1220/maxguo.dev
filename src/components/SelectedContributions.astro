---
import records from '../data/contributions.json';
import { selectedContributions, storyEvents, EVENT_LABELS, formatDay, evidenceCta, eventMaturity } from '../lib/contributions.mjs';
import ContributionStatus from './ContributionStatus.astro';
const [featured, ...remaining] = selectedContributions(records);
const featuredStory = featured ? storyEvents(featured, records) : [];
---
<section id="contributions" class="mb-14">
  <span class="section-kicker">Public record</span>
  <h2 class="mt-2 mb-3">Selected Contributions</h2>

  {featured && <article data-selected-id={featured.id} class="contribution-featured" data-maturity="established">
    <p class="contribution-project">{featured.project}</p>
    <ContributionStatus record={featured} />
    <h3 class="contribution-featured-title"><a href={featured.url}>{featured.title}</a></h3>
    <p class="contribution-featured-summary">{featured.contribution}</p>
    <a href={featured.url} class="link-arrow">{evidenceCta(featured)}</a>
    {featuredStory.length > 1 && <ol class="contribution-featured-story" aria-label={`${featured.project} contribution story`}>
      {featuredStory.map(event => <li data-maturity={eventMaturity(event)}><a href={`/contributions/#${event.id}`}>{EVENT_LABELS[event.event]} · {formatDay(event.localDate)}</a></li>)}
    </ol>}
  </article>}

  <ol class="contribution-selection" aria-label="Other selected contributions">
    {remaining.map(record => {
      const isEstablished = ['merged', 'released', 'preprint', 'published', 'public', 'fixed_upstream'].includes(record.status);
      const story = storyEvents(record, records);
      return <li data-selected-id={record.id} class="contribution-selection-item" data-maturity={isEstablished ? 'established' : 'developing'}>
        <p class="contribution-project">{record.project}</p>
        <ContributionStatus record={record} />
        <h3 class="contribution-selection-title"><a href={record.url}>{record.title}</a></h3>
        <p class="contribution-selection-summary">{record.contribution}</p>
        <a href={record.url} class="link-arrow">{evidenceCta(record)}</a>
        {story.length > 1 && <ol class="contribution-selection-story" aria-label={`${record.project} contribution story`}>
          {story.map(event => <li data-maturity={eventMaturity(event)}><a href={`/contributions/#${event.id}`}>{EVENT_LABELS[event.event]} · {formatDay(event.localDate)}</a></li>)}
        </ol>}
      </li>;
    })}
  </ol>

  <a href="/contributions/" class="link-arrow mt-5">View the full contribution log →</a>
</section>
