---
import BaseLayout from '../../layouts/BaseLayout.astro';

const published = [
  {
    number: '01',
    kind: '测量权力 / MEASUREMENT',
    title: '谁的时间被计算？',
    subtitle: 'China Time Use 2024',
    description: '统计口径不是社会现实本身。追问有酬与无酬劳动的界限，如何改变我们对日常生活的理解。',
    href: '/research/china-time-use-2024/',
    status: '已发布 / PUBLISHED'
  },
  {
    number: '02',
    kind: '回答与回避 / ANSWERABILITY',
    title: '正确的废话',
    subtitle: 'The Language of Non-Answers',
    description: '公共回答说了什么、绕开了什么，又凭什么让读者认为问题已经得到解释？',
    href: '/non-answers/',
    status: '已发布 / PUBLISHED'
  }
];

const inProgress = [
  {
    number: '03',
    kind: '事实定性 / AUTHORITY',
    title: '谁有权定义谣言？',
    subtitle: 'Who Defines a Rumor?',
    description: '追踪一项说法的原始含义、辟谣证据、机构权力与后来的事实更新；区分未经证实、被证伪与政策变化。',
    status: '证据审计中 / RESEARCH IN PROGRESS'
  },
  {
    number: '04',
    kind: '叙事与归因 / NARRATIVE',
    title: '解释的边界',
    subtitle: 'The Boundaries of Explanation',
    description: '同一公共事件为何会有不同的责任归因和因果解释？哪些差异来自新增证据，哪些来自编辑选择？',
    status: '案例核验中 / RESEARCH IN PROGRESS'
  }
];

const lenses = [
  ['01', '审查与沉默', 'Censorship & Silence', '谁可以表达？什么被限制、删除或迫使改写？'],
  ['02', '宣传与解释权', 'Propaganda & Narrative Power', '谁决定问题如何被提出，原因如何被解释？'],
  ['03', '历史与记忆', 'History & Collective Memory', '什么被保存下来？什么在版本更新中消失？'],
  ['04', '认知与服从', 'Cognition & Conformity', '信息与风险环境如何影响表达和判断？'],
  ['05', '数字权力与 AI', 'Digital Power & AI', '当工具成为知识入口，信息边界如何被重新生产？']
];
---
<BaseLayout
  title="言说的边界 · Critical Inquiry"
  description="独立批判性研究：追问中国的信息审查、政治宣传、叙事权力、历史记忆与公共知识。"
>
  <div class="ci-root" lang="zh-CN">
    <header class="ci-hero">
      <div class="ci-wrap">
        <p class="ci-eyebrow">独立批判性研究 / INDEPENDENT CRITICAL INQUIRY</p>
        <h1>言说的边界<span class="ci-title-en">The Boundaries of the Sayable</span></h1>
        <p class="ci-hero-lede">谁定义事实？谁书写历史？<br />谁决定什么值得被解释，又有什么不必被回答？</p>
        <p class="ci-hero-desc">
          以中国为主要研究对象，追问信息审查、政治宣传、社会叙事与公共权力如何影响知识的生产、流通和记忆。
          我们不以“平衡双方”为目标，也不把质疑当作事实。<strong>批判性决定追问什么；证据决定能够断言什么。</strong>
        </p>
        <div class="ci-hero-nav">
          <a href="#works">进入研究专题 <span aria-hidden="true">↗</span></a>
          <a href="#method">研究原则 <span aria-hidden="true">↘</span></a>
        </div>
      </div>
      <div class="ci-hero-number" aria-hidden="true">01—05</div>
    </header>

    <main class="ci-wrap ci-main">
      <section class="ci-manifesto" aria-labelledby="ci-manifesto-heading">
        <div class="ci-section-side"><span>POSITION / 立场</span></div>
        <div>
          <h2 id="ci-manifesto-heading">公共权力不应免于追问。</h2>
          <p>与其只问一条信息是真是假，我们还追问：谁拥有为它贴标签的权力？谁的解释成为通用版本？纠错发生时，原先的判断和后果是否还被记得？</p>
          <p>对权力的审查并不要求预设每项官方声明都不正确。它要求更清楚地标出<strong>证据、程序、责任与不确定性</strong>，并允许研究本身被复核和更正。</p>
        </div>
      </section>

      <section class="ci-section" id="works" aria-labelledby="ci-works-title">
        <div class="ci-heading-line"><span>RESEARCH / 研究</span><span>已发布与研究中</span></div>
        <h2 id="ci-works-title">从统计口径到解释权</h2>
        <p class="ci-intro">各专题独立回答问题，共用一条方法底线：不以后见之明替代当时的信息，不把文本差异直接当作审查意图。</p>
        <div class="ci-card-grid">
          {published.map((work) => (
            <a class="ci-card ci-card-link" href={work.href}>
              <div class="ci-card-head"><span>{work.number} · {work.kind}</span><span class="ci-ready">{work.status}</span></div>
              <h3>{work.title}</h3><p class="ci-subtitle">{work.subtitle}</p>
              <p class="ci-card-copy">{work.description}</p>
              <span class="ci-card-cta">阅读已发布研究 <span aria-hidden="true">↗</span></span>
            </a>
          ))}
          {inProgress.map((work) => (
            <article class="ci-card ci-card-pending">
              <div class="ci-card-head"><span>{work.number} · {work.kind}</span></div>
              <h3>{work.title}</h3><p class="ci-subtitle">{work.subtitle}</p>
              <p class="ci-card-copy">{work.description}</p>
              <span class="ci-pending-label">{work.status} · 暂不公开未审定案例</span>
            </article>
          ))}
        </div>
      </section>

      <section class="ci-section" aria-labelledby="ci-lenses-title">
        <div class="ci-heading-line"><span>RESEARCH LENSES / 研究视角</span><span>长期议题</span></div>
        <h2 id="ci-lenses-title">研究信息，也研究权力</h2>
        <div class="ci-lenses">
          {lenses.map(([number, title, subtitle, question]) => (
            <div class="ci-lens">
              <span class="ci-lens-number">{number}</span>
              <div><h3>{title}</h3><span>{subtitle}</span></div>
              <p>{question}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="ci-feature" aria-labelledby="ci-feature-title">
        <span class="ci-feature-kicker">ARCHIVE IN DEVELOPMENT / 历史证据档案 · 内部研究中</span>
        <h2 id="ci-feature-title">当时，人们能够知道什么？</h2>
        <p>疫情时期的信息争议提供了一个方法试验场：同一项说法如何被提出、核查、限制传播、调整判断或纳入历史记录？</p>
        <div class="ci-steps">
          <span>当时可得资料</span><span aria-hidden="true">→</span><span>当时的公共判断</span><span aria-hidden="true">→</span><span>后续证据与纠错</span>
        </div>
        <p class="ci-small">研究档案尚在核验。页面暂不展示未经二次审定的原始社交媒体截图、私人身份信息、事件传播规模或因果结论。</p>
      </section>

      <section class="ci-section ci-method" id="method" aria-labelledby="ci-method-title">
        <div class="ci-heading-line"><span>METHOD / 方法与责任</span><span>可反驳、可更正</span></div>
        <h2 id="ci-method-title">我们的批判也必须接受审查</h2>
        <div class="ci-method-grid">
          <div><span>01</span><h3>原始材料优先</h3><p>明确区分原始页面、同期转载、记者转述、后期回忆和研究者解释。</p></div>
          <div><span>02</span><h3>证据必须带时间</h3><p>后来的调查只能检验早期判断，不能证明当时的个人或机构必然已掌握相同信息。</p></div>
          <div><span>03</span><h3>区分权力与真伪</h3><p>机构有权力不意味着其陈述必然错误；主张未获证实也不等于它已被证伪。</p></div>
          <div><span>04</span><h3>保护普通人的隐私</h3><p>原则上不重新暴露普通社交媒体用户的身份、联系方式、面容和无关个人信息。</p></div>
          <div><span>05</span><h3>公开修改理由</h3><p>研究结论更新时标出版本、修改日期、证据新增和撤回的断言。</p></div>
          <div><span>06</span><h3>承认方法边界</h3><p>文本分析不能独自证明政治指令、个体动机、全国性普遍程度或公众实际心理变化。</p></div>
        </div>
      </section>
      <footer class="ci-local-footer">
        <p>这是 Baixin Guo（郭佰鑫）的个人兴趣研究线，与 AI/ML 研究议程并行；不以论文发表或申请履历作为立项门槛。</p>
        <a href="/research/">返回个人研究页 <span aria-hidden="true">↗</span></a>
      </footer>
    </main>
  </div>
</BaseLayout>

<style>
  .ci-root { --ci-ink:#192935; --ci-dim:#536575; --ci-rule:#d0d8dc; --ci-accent:#8b402b; font-family: "Noto Sans CJK SC","PingFang SC","Microsoft YaHei",system-ui,sans-serif; color:var(--ci-ink); }
  .ci-wrap {max-width:1100px;margin:0 auto;padding:0 clamp(1.15rem,4vw,2.5rem)}
  .ci-hero {background:#162731;color:#f5f1eb;position:relative;overflow:hidden;padding:clamp(4.5rem,9vw,7.5rem) 0 clamp(4rem,7vw,6rem)}
  .ci-eyebrow,.ci-heading-line,.ci-feature-kicker {font-family:var(--font-mono,monospace);font-size:.68rem;letter-spacing:.13em;text-transform:uppercase}
  .ci-eyebrow{color:#d9ad8e;margin:0 0 1.7rem}
  .ci-hero h1{font-size:clamp(2.75rem,7.5vw,6.1rem);line-height:1.13;letter-spacing:-.04em;margin:0;font-weight:700;max-width:900px;color:#fff}
  .ci-title-en{display:block;font-family:Georgia,serif;font-size:clamp(1rem,2vw,1.45rem);font-weight:400;letter-spacing:.02em;color:#b5c5cb;margin-top:1rem}
  .ci-hero-lede{font-size:clamp(1.25rem,3vw,2.1rem);line-height:1.6;font-weight:600;margin:2.25rem 0 1.25rem;color:#fff}
  .ci-hero-desc{max-width:770px;color:#c7d3d6;font-size:.96rem;line-height:1.95;margin:0}
  .ci-hero-desc strong{color:#fff}
  .ci-hero-nav{display:flex;gap:1.8rem;flex-wrap:wrap;margin-top:2.2rem}
  .ci-hero-nav a{color:#f7d5bf;border-bottom:1px solid #b9795e;padding-bottom:.28rem;font-size:.85rem;text-decoration:none}
  .ci-hero-number{position:absolute;right:2vw;bottom:-4rem;font-size:clamp(6rem,16vw,16rem);font-family:Georgia,serif;color:#ffffff08;pointer-events:none}
  .ci-main{padding-top:3.75rem;padding-bottom:3rem}
  .ci-manifesto{display:grid;grid-template-columns:200px minmax(0,1fr);gap:2rem;border-bottom:1px solid var(--ci-rule);padding-bottom:4rem}
  .ci-section-side{font:600 .68rem var(--font-mono,monospace);letter-spacing:.1em;color:var(--ci-accent)}
  .ci-manifesto h2{font-size:clamp(1.6rem,3vw,2.45rem);margin:0 0 1.5rem;letter-spacing:-.025em}
  .ci-manifesto p{font-size:1rem;line-height:1.92;color:var(--ci-dim);max-width:750px;margin:0 0 .85rem}
  .ci-manifesto strong{color:var(--ci-ink)}
  .ci-section{padding:4.3rem 0;border-bottom:1px solid var(--ci-rule)}
  .ci-heading-line{display:flex;justify-content:space-between;gap:1rem;color:var(--ci-accent);margin-bottom:1.15rem}
  .ci-heading-line span:last-child{color:#70808a}
  .ci-section h2{font-size:clamp(1.7rem,3vw,2.7rem);letter-spacing:-.035em;margin:0 0 1rem}
  .ci-intro{line-height:1.85;color:var(--ci-dim);max-width:750px;margin-bottom:1.8rem}
  .ci-card-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}
  .ci-card{border:1px solid var(--ci-rule);padding:1.8rem;display:flex;flex-direction:column;min-height:320px;text-decoration:none;background:#fff;border-radius:3px;transition:border-color .15s}
  .ci-card-link:hover,.ci-card-link:focus-visible{border-color:var(--ci-accent)}
  .ci-card-pending{background:#f7f7f5}
  .ci-card-head{font:600 .58rem/1.6 var(--font-mono,monospace);letter-spacing:.04em;color:var(--ci-accent);display:flex;justify-content:space-between;gap:1rem;flex-wrap:wrap}
  .ci-ready{color:#446e64}
  .ci-card h3{font-size:clamp(1.45rem,2.6vw,1.95rem);line-height:1.35;color:var(--ci-ink);margin:1.4rem 0 .15rem;font-weight:650}
  .ci-subtitle{font:italic .85rem Georgia,serif;color:#74848e;margin:.1rem 0 1.1rem}
  .ci-card-copy{font-size:.89rem;line-height:1.85;color:var(--ci-dim);margin:0 0 2rem}
  .ci-card-cta,.ci-pending-label{margin-top:auto;font-size:.72rem;font-weight:600;color:var(--ci-accent)}
  .ci-pending-label{color:#687983;font-weight:400}
  .ci-lenses{margin-top:2rem;border-top:1px solid var(--ci-rule)}
  .ci-lens{display:grid;grid-template-columns:50px minmax(180px,1fr) minmax(0,1.35fr);gap:1.2rem;padding:1.55rem .1rem;border-bottom:1px solid var(--ci-rule);align-items:start}
  .ci-lens-number{font:700 .68rem var(--font-mono,monospace);color:var(--ci-accent);padding-top:.35rem}
  .ci-lens h3{font-size:1.1rem;margin:0 0 .25rem}
  .ci-lens div span{font:italic .78rem Georgia,serif;color:#687983}
  .ci-lens p{margin:0;line-height:1.8;color:var(--ci-dim);font-size:.86rem}
  .ci-feature{margin-top:4rem;padding:2.5rem;background:#e9eeed;border-left:4px solid #8b402b;border-radius:2px}
  .ci-feature-kicker{color:#7b493d}
  .ci-feature h2{font-size:clamp(1.7rem,3vw,2.3rem);margin:1rem 0}
  .ci-feature>p{color:var(--ci-dim);line-height:1.85;max-width:760px}
  .ci-steps{display:flex;gap:.8rem;align-items:center;flex-wrap:wrap;font-size:.8rem;margin:1.5rem 0;color:var(--ci-ink)}
  .ci-steps span:nth-child(even){color:var(--ci-accent)}
  .ci-feature .ci-small{font-size:.76rem;color:#64757e;margin-bottom:0}
  .ci-method-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.6rem 1.9rem;margin-top:2rem}
  .ci-method-grid>div{border-top:2px solid var(--ci-ink);padding-top:.9rem}
  .ci-method-grid span{font:.72rem var(--font-mono,monospace);color:var(--ci-accent)}
  .ci-method-grid h3{font-size:1rem;margin:.55rem 0}
  .ci-method-grid p{font-size:.82rem;line-height:1.8;color:var(--ci-dim)}
  .ci-local-footer{display:flex;justify-content:space-between;gap:1.5rem;align-items:start;padding:2rem 0}
  .ci-local-footer p{font-size:.75rem;line-height:1.75;color:var(--ci-dim);max-width:630px;margin:0}
  .ci-local-footer a{font-size:.76rem;color:var(--ci-accent);white-space:nowrap}
  @media(max-width:750px){
    .ci-manifesto{grid-template-columns:1fr;gap:1rem}
    .ci-card-grid{grid-template-columns:1fr}
    .ci-card{min-height:auto}
    .ci-lens{grid-template-columns:34px 1fr;gap:.6rem}
    .ci-lens p{grid-column:2}
    .ci-method-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
    .ci-local-footer{flex-direction:column}
  }
  @media(max-width:480px){
    .ci-hero{padding:4rem 0 3.5rem}
    .ci-method-grid{grid-template-columns:1fr}
    .ci-card{padding:1.3rem}
    .ci-feature{padding:1.5rem}
    .ci-heading-line{font-size:.59rem}
  }
</style>
