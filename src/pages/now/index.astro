---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import PublicationStatus from '../../components/PublicationStatus.astro';

const checkMyCoachPaper = (await getCollection('publication')).find(({ id }) => id === 'checkmycoach-paper');
---
<BaseLayout title="Now" description="What Baixin Guo is working on right now">
  <div class="container-content py-16">
    <div class="max-w-2xl">

      <span class="section-label mb-4">Now</span>
      <h1 class="mb-2">What I'm Working On</h1>
      <p class="text-sm text-[var(--color-text-dim)] mb-8">Updated August 2026</p>

        <div class="card-static mb-6">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-secondary)]"></span>
            <span class="font-mono text-[0.6rem] font-semibold text-[var(--color-secondary)] uppercase tracking-wider">Frozen</span>
          </div>
          <h2 class="text-[1.05rem] mb-1">InteractionKit v1.0.0 Released</h2>
          <p class="text-sm text-[var(--color-text-dim)]">Frozen methodological asset (2026-08-03); v1.0.0 publicly tagged. Evidence covers contracts, type checking, build, and clean-install reproduction—not human validity. The human study is deferred, not an active priority.</p>
        </div>

      <div class="space-y-6">

        <div class="card-static">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-primary)]"></span>
            {checkMyCoachPaper && <PublicationStatus status={checkMyCoachPaper.data.status} class="text-[0.6rem]" />}
          </div>
          <h2 class="text-[1.05rem] mb-1">CheckMyCoach Human Validation</h2>
          <p class="text-sm text-[var(--color-text-dim)]">Active path: human validation of the uncertainty-communication measurement toward the combined Precision Illusion + CheckMyCoach paper. The standalone v2.2 offline evaluation is archived; no superiority, validated-detection, equivalence, or user-effect claim.</p>
        </div>

        <div class="card-static">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-secondary)]"></span>
            <span class="font-mono text-[0.6rem] font-semibold text-[var(--color-secondary)] uppercase tracking-wider">Frozen</span>
          </div>
          <h2 class="text-[1.05rem] mb-1">Earlier Prototypes</h2>
          <p class="text-sm text-[var(--color-text-dim)]">MaxFitCalib-Bench is closed as an engineering-only audit; CalTrust is frozen as a simulation-only prototype. Neither is an active scientific claim.</p>
        </div>

        <div class="card-static">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-gold)]"></span>
            <span class="font-mono text-[0.6rem] font-semibold text-[var(--color-gold)] uppercase tracking-wider">Building</span>
          </div>
          <h2 class="text-[1.05rem] mb-1">PI Discovery Engine</h2>
          <p class="text-sm text-[var(--color-text-dim)]">Streamlit web app for finding and tracking potential PhD advisors. v0.3 with email pipeline.</p>
        </div>

        <div class="card-static">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-secondary)]"></span>
            <span class="font-mono text-[0.6rem] font-semibold text-[var(--color-secondary)] uppercase tracking-wider">Reading</span>
          </div>
          <h2 class="text-[1.05rem] mb-1">Trust Calibration in Human-AI Interaction</h2>
          <p class="text-sm text-[var(--color-text-dim)]">Kahneman's Thinking Fast and Slow, dual-process theory, and calibration literature for Paper 2 discussion.</p>
        </div>

      </div>

      <p class="text-xs text-[var(--color-text-muted)] mt-8 italic">Inspired by <a href="https://nownownow.com" class="underline hover:text-[var(--color-primary)]">nownownow.com</a></p>
    </div>
  </div>
</BaseLayout>
