---
import BaseLayout from '../../layouts/BaseLayout.astro';
import profile from '../../data/research-profile.json';
---
<BaseLayout title="Now" description="Current research on human feedback, preferences, and evaluation reliability">
  <div class="container-content py-16"><div class="max-w-2xl">
    <span class="section-label mb-4">Now</span><h1 class="mb-3">What I'm working on</h1>
    <p class="text-sm text-[var(--color-text-dim)] mb-8">Updated October 2026</p>
    <div class="space-y-5">
      {profile.collaborations.map(work => <article class="card-static"><p class="work-kind mb-2">{work.status}</p><h2 class="text-lg mb-2">{work.title}</h2><p class="text-sm text-[var(--color-text-dim)] mb-3">{work.summary}</p><a href={`/research/#${work.id}`} class="link-arrow">Contribution and scope →</a></article>)}
      <article class="card-static"><h2 class="text-lg mb-2">Controlled tests of adaptation</h2><p class="text-sm text-[var(--color-text-dim)]">PMD's confirmatory preference diagnostic is frozen. I am exploring how to test adaptation against held-out outcomes while retaining uncertainty about the feedback signal.</p></article>
      <article class="card-static"><h2 class="text-lg mb-2">Human-centered verification</h2><p class="text-sm text-[var(--color-text-dim)]">CheckMyCoach human validation remains in preparation. Human evaluation has not yet been conducted.</p></article>
      <article class="card-static"><h2 class="text-lg mb-2">Open-source regression examples</h2><p class="text-sm text-[var(--color-text-dim)]">Three SkillHone contribution PRs await review. The initial Jev x TIND audit is preliminary; no experiments have been run.</p></article>
    </div>
    <p class="text-sm text-[var(--color-text-dim)] mt-8">Open to research collaboration and RA opportunities. <a href="/cv/" class="link-arrow">Current CV →</a></p>
  </div></div>
</BaseLayout>
