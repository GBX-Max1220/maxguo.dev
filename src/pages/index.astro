---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/research-profile.json';
import SelectedResearch from '../components/SelectedResearch.astro';
import EngineeringList from '../components/EngineeringList.astro';
import ActivityLog from '../components/ActivityLog.astro';
import Collaboration from '../components/Collaboration.astro';
import '../styles/contribution-editorial.css';
---

<BaseLayout title="Home" description="Baixin Guo (Max) — research on reliable adaptation from imperfect human, evaluator, and environment feedback." ogImage="/og/home.png" hideTopBar>

<div class="container-shell">
  <!-- Hero: identity + research question -->
  <section id="intro" class="hero-section" aria-labelledby="hero-name">
    <div class="hero-text">
      <p class="hero-kicker">Human-centered AI · Feedback · Reliable agents</p>
      <p id="hero-name" class="hero-name">Baixin Guo</p>
      <p class="hero-handle">Max · independent researcher</p>
      <h1 class="hero-headline">{profile.headline}</h1>
      <p class="hero-question">{profile.question}</p>
      <p class="hero-bio">{profile.profile}</p>

      <div class="hero-links">
        <a href="/cv/" class="btn btn-primary btn-sm">CV</a>
        <a href="https://github.com/GBX-Max1220" target="_blank" rel="noopener" class="btn btn-sm">GitHub</a>
        <a href="mailto:gbx1220max@gmail.com" class="btn btn-sm">Email</a>
        <a href="https://www.linkedin.com/in/baixin-guo-681113285/" target="_blank" rel="noopener" class="btn btn-sm">LinkedIn</a>
      </div>
    </div>

    <figure class="hero-figure" aria-label="Research agenda overview">
      <img src="/images/home-hero.png" alt="Conceptual overview of feedback, state, and evaluation in human-AI systems" width="1200" height="500" loading="eager" />
    </figure>
  </section>

  <!-- Main content flow -->
  <div class="main-flow">
    <SelectedResearch />
    <EngineeringList />

    <section id="latest" class="contribution-latest" aria-labelledby="latest-heading">
      <div class="flex items-end justify-between mb-4">
        <div>
          <span class="section-kicker">Dated evidence</span>
          <h2 id="latest-heading" class="mt-2">Recent activity</h2>
        </div>
        <a href="/contributions/" class="link-arrow">Full log →</a>
      </div>
      <ActivityLog />
    </section>

    <Collaboration />
  </div>
</div>

</BaseLayout>

<style>
  .hero-section {
    display: grid;
    gap: 2rem;
    padding: 2.5rem 0 3rem;
    border-bottom: 1px solid var(--color-rule-light);
  }

  @media (min-width: 1024px) {
    .hero-section {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
      gap: 3rem;
      padding: 4rem 0 4.5rem;
    }
  }

  .hero-text {
    max-width: 38rem;
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.05;
    color: var(--color-ink);
    margin: 0 0 0.25rem;
  }

  .hero-handle {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 1.5rem;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 3.1rem);
    line-height: 1.1;
    color: var(--color-ink);
    margin: 0 0 0.9rem;
  }

  .hero-question {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    line-height: 1.4;
    color: var(--color-brand);
    margin: 0 0 1.1rem;
  }

  .hero-bio {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-dim);
    margin: 0 0 1.4rem;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero-figure {
    margin: 0;
  }

  .hero-figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-rule-light);
    background: var(--color-surface);
  }

  .main-flow {
    padding: 2.5rem 0 4rem;
  }

  @media (min-width: 768px) {
    .main-flow {
      padding: 3.5rem 0 5rem;
    }
  }
</style>
