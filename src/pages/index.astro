---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/research-profile.json';
import SelectedResearch from '../components/SelectedResearch.astro';
import EngineeringList from '../components/EngineeringList.astro';
import ActivityLog from '../components/ActivityLog.astro';
import Collaboration from '../components/Collaboration.astro';
import '../styles/contribution-editorial.css';
---

<BaseLayout title="Home" description="Baixin Guo (Max) — research on reliable adaptation from imperfect human, evaluator, and environment feedback." ogImage="/og/home.png" hideTopBar>

<div class="container-shell">
  <!-- Hero: identity + research question -->
  <section id="intro" class="hero-section" aria-labelledby="hero-name">
    <div class="hero-text">
      <p class="hero-kicker">Human-centered AI · Feedback · Reliable agents</p>
      <p id="hero-name" class="hero-name">Baixin Guo <span class="hero-max">(Max)</span></p>
      <p class="hero-name-cn" lang="zh-Hans">郭佰鑫</p>
      <p class="hero-pronunciation"><span>Pronounced</span> “bye-shin gwo” <details><summary>Mandarin pronunciation</summary><span lang="zh-Latn-pinyin">Bǎixīn Guō</span> · <span lang="zh-Latn-fonipa">[paɪ̯˨˩˦ ɕin˥ ku̯ɔ˥]</span></details></p>
      <p class="hero-handle">Independent researcher</p>
      <nav class="hero-links" aria-label="Contact and profiles">
        <a href="mailto:gbx1220max@gmail.com" aria-label="Email Baixin Guo"><svg aria-hidden="true" viewBox="0 0 16 16"><path d="M2 3.5h12v9H2zM2.5 4l5.5 4.5L13.5 4" /></svg>Email</a>
        <a href="https://github.com/GBX-Max1220" target="_blank" rel="noopener"><svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 1.5a6.5 6.5 0 0 0-2.05 12.67c.33.06.45-.14.45-.32v-1.2c-1.83.4-2.22-.78-2.22-.78-.3-.76-.73-.96-.73-.96-.6-.41.05-.4.05-.4.66.05 1.01.68 1.01.68.59 1.01 1.54.72 1.91.55.06-.43.23-.72.42-.89-1.46-.17-3-.73-3-3.24 0-.72.26-1.3.68-1.76-.07-.17-.3-.84.07-1.74 0 0 .55-.18 1.79.67A6.2 6.2 0 0 1 8 4.56c.56 0 1.12.08 1.64.22 1.24-.85 1.79-.67 1.79-.67.37.9.14 1.57.07 1.74.42.46.68 1.04.68 1.76 0 2.52-1.54 3.07-3.01 3.23.24.21.45.61.45 1.23v1.78c0 .18.12.39.46.32A6.5 6.5 0 0 0 8 1.5Z" /></svg>GitHub</a>
        <a href="https://www.linkedin.com/in/baixin-guo-681113285/" target="_blank" rel="noopener"><svg aria-hidden="true" viewBox="0 0 16 16"><path d="M3 5.5v7M3 3.2v.1M6.5 12.5v-4a2 2 0 0 1 4 0v4M6.5 7v5.5M2 2h12v12H2z" /></svg>LinkedIn</a>
        <a href="/cv/"><svg aria-hidden="true" viewBox="0 0 16 16"><path d="M4 1.5h5l3 3v10H4zM9 1.5v3h3M6 8h4M6 10.5h4" /></svg>CV</a>
      </nav>
      <h1 class="hero-headline">{profile.headline}</h1>
      <p class="hero-question">{profile.question}</p>
      <p class="hero-bio">{profile.profile}</p>
      <p class="hero-bio hero-openness">{profile.openness}</p>
      <div class="hero-methods-callout">
        <span class="hero-methods-eyebrow">New interactive methods lab · Recommender systems</span>
        <a class="hero-methods-link" href="/research/offline-policy-improvement/">
          <span lang="zh-Hans">离线评价何时误导我们？</span>
          <span class="hero-methods-en">When Offline Evaluation Misleads <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </div>

    <figure class="hero-figure" aria-label="Research agenda overview">
      <img src="/images/home-hero.png" alt="Conceptual overview of feedback, state, and evaluation in human-AI systems" width="1200" height="500" loading="eager" />
    </figure>
  </section>

  <!-- Main content flow -->
  <div class="main-flow">
    <SelectedResearch />

    <!-- Interactive methods: synthetic, reproducible teaching labs. -->
    <section id="interactive-methods" class="public-writing-section" aria-labelledby="interactive-methods-heading">
      <div class="public-writing-header">
        <span class="section-kicker">Recommender systems · Interactive methods</span>
        <h2 id="interactive-methods-heading">Methods Lab / 交互方法实验</h2>
      </div>
      <a class="public-writing-feature" href="/research/offline-policy-improvement/">
        <span class="public-writing-tag">Synthetic study · Contextual bandits · 简体 / EN</span>
        <strong class="public-writing-title">When Offline Evaluation Misleads</strong>
        <span class="public-writing-subtitle" lang="zh-Hans">离线评价何时误导我们？</span>
        <span class="public-writing-desc">A reproducible simulation of sparse logging, wrong propensities, offline estimates and policy-selection mistakes; not a real-user study or deployment guarantee.</span>
        <span class="public-writing-link">Explore the lab / 进入实验 →</span>
      </a>
    </section>

    <EngineeringList />

    <!-- Public essays: standalone, evidence-led communication projects. -->
    <section id="public-writing" aria-labelledby="public-writing-title" class="public-writing-section">
      <div class="public-writing-header">
        <span class="section-kicker">Social & technology · Public writing</span>
        <h2 id="public-writing-title">Public writing / 公开写作</h2>
      </div>
      <a class="public-writing-feature" href="/critical-inquiry/" lang="zh-CN">
        <span class="public-writing-tag">Critical Inquiry · 中国社会与信息权力 · 研究入口</span>
        <strong class="public-writing-title">言说的边界</strong>
        <span class="public-writing-subtitle">The Boundaries of the Sayable</span>
        <span class="public-writing-desc">审查与沉默、宣传与解释权、历史记忆与数字权力。以可核验的证据研究公共言说如何被界定，以及谁拥有界定的权力。</span>
        <span class="public-writing-link">进入独立批判性研究入口 →</span>
      </a>

      <a class="public-writing-feature" href="/non-answers/">
        <span class="public-writing-tag">Interactive essay · 简体 / 繁體 / EN</span>
        <strong class="public-writing-title" lang="zh-Hans">正确的废话</strong>
        <span class="public-writing-subtitle">The Language of Non-Answers</span>
        <span class="public-writing-desc" lang="zh-Hans">从18份政务、外交和媒体文本出发，追问政治语言说了什么、没有回答什么，以及证据真正支持什么。</span>
        <span class="public-writing-link">Read the feature / 阅读专题 →</span>
      </a>
    </section>

    <section id="latest" class="contribution-latest" aria-labelledby="latest-heading">
      <div class="flex items-end justify-between mb-4">
        <div>
          <span class="section-kicker">Dated evidence</span>
          <h2 id="latest-heading" class="mt-2">Recent activity</h2>
        </div>
        <a href="/contributions/" class="link-arrow">Full log →</a>
      </div>
      <ActivityLog />
    </section>

    <Collaboration />
  </div>
</div>

</BaseLayout>

<style>
  @font-face {
    font-family: "Noto Name Subset";
    src: url('../assets/noto-name-subset.otf') format('opentype');
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    unicode-range: U+90ED, U+4F70, U+946B;
  }
  .hero-section {
    display: grid;
    gap: 2rem;
    padding: 2.5rem 0 3rem;
    border-bottom: 1px solid var(--color-rule-light);
  }

  @media (min-width: 1024px) {
    .hero-section {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: center;
      gap: 3rem;
      padding: 4rem 0 4.5rem;
    }
  }

  .hero-text {
    max-width: 38rem;
  }

  .hero-kicker {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-primary);
    margin: 0 0 0.75rem;
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1.05;
    color: var(--color-ink);
    margin: 0 0 0.25rem;
  }

  .hero-max { font-family: var(--font-sans); font-size: .48em; font-weight: 500; color: var(--color-text-muted); }
  .hero-name-cn { margin: -.05rem 0 .25rem; font: 400 1rem/1.5 "Noto Name Subset", "Noto Sans CJK SC", "Microsoft YaHei", "PingFang SC", sans-serif; letter-spacing: .08em; color: var(--color-text-dim); }
  .hero-pronunciation { display: flex; flex-wrap: wrap; align-items: baseline; gap: .35rem; margin: 0 0 .65rem; color: var(--color-text-muted); font-size: .75rem; }
  .hero-pronunciation > span:first-child { font-family: var(--font-mono); font-size: .65rem; text-transform: uppercase; letter-spacing: .08em; }
  .hero-pronunciation details { display: inline; }
  .hero-pronunciation summary { display: inline; cursor: pointer; color: var(--color-brand); }
  .hero-pronunciation details span { margin-left: .4rem; }

  .hero-handle {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 1.5rem;
  }

  .hero-headline {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 5vw, 3.1rem);
    line-height: 1.1;
    color: var(--color-ink);
    margin: 0 0 0.9rem;
  }

  .hero-question {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    line-height: 1.4;
    color: var(--color-brand);
    margin: 0 0 1.1rem;
  }

  .hero-bio {
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text-dim);
    margin: 0 0 1.4rem;
  }

  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin: 0 0 1.5rem;
    font: 600 .72rem/1.5 var(--font-mono);
  }
  .hero-links a { color: var(--color-brand); text-decoration: none; border-bottom: 1px solid var(--color-rule); }
  .hero-links a { display: inline-flex; align-items: center; gap: .3rem; }
  .hero-links svg { width: .9rem; height: .9rem; fill: none; stroke: currentColor; stroke-width: 1.35; stroke-linecap: round; stroke-linejoin: round; }
  .hero-links a:nth-child(2) svg { fill: currentColor; stroke: none; }
  .hero-links a:hover, .hero-links a:focus-visible { border-color: currentColor; }
  .hero-handle { margin-bottom: .55rem; }
  .hero-headline { margin-top: 0;
  }

  .hero-methods-callout {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0.1rem 0 1.5rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--color-rule);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .hero-methods-eyebrow {
    color: var(--color-primary);
    font: 600 0.62rem/1.5 var(--font-mono);
    letter-spacing: 0.035em;
  }
  .hero-methods-link {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15rem 0.7rem;
    color: var(--color-brand);
    font-weight: 650;
    text-decoration: none;
  }
  .hero-methods-link:hover,
  .hero-methods-link:focus-visible { text-decoration: underline; }
  .hero-methods-en { font-size: 0.8rem; color: var(--color-text-dim); }

  .hero-figure {
    margin: 0;
  }

  .hero-figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-rule-light);
    background: var(--color-surface);
  }

  .main-flow {
    padding: 2.5rem 0 4rem;
  }

  @media (min-width: 768px) {
    .main-flow {
      padding: 3.5rem 0 5rem;
    }
  }

  .public-writing-section {
    margin: 2.4rem 0 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-rule-light);
  }
  .public-writing-header h2 {
    margin: 0.3rem 0 1rem;
    font-size: clamp(1.3rem, 2vw, 1.6rem);
  }
  .public-writing-feature {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    max-width: 100%;
    padding: 1.35rem 1.5rem;
    border: 1px solid var(--color-rule);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    text-decoration: none;
    transition: border-color .15s, transform .15s;
  }
  .public-writing-feature:hover,
  .public-writing-feature:focus-visible { border-color: var(--color-primary); }
  .public-writing-tag,
  .public-writing-subtitle,
  .public-writing-link {
    font: 0.65rem/1.55 var(--font-mono);
    color: var(--color-text-dim);
  }
  .public-writing-tag { color: var(--color-primary); }
  .public-writing-title {
    color: var(--color-ink);
    font: 600 clamp(1.45rem, 2.9vw, 1.9rem)/1.25 var(--font-display);
  }
  .public-writing-desc {
    margin-top: .35rem;
    max-width: 64ch;
    color: var(--color-text-dim);
    font-size: 0.86rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }
  .public-writing-link { margin-top: .5rem; color: var(--color-brand); font-weight: 600; }
  @media (max-width: 420px) { .public-writing-feature { padding: 1rem; } }
</style>
