---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/research-profile.json';
import SelectedContributions from '../components/SelectedContributions.astro';
import ActivityLog from '../components/ActivityLog.astro';
import '../styles/contribution-editorial.css';
---

<BaseLayout title="Home" description="Human-centered AI research on imperfect feedback, preference modeling, and reliable agents." ogImage="/og/home.png" hideTopBar>

<!-- ================================================================ -->
<!-- Hybrid editorial homepage: identity rail + research agenda flow   -->
<!-- ================================================================ -->
<div class="container-shell">
  <div class="flex flex-col lg:flex-row gap-0 lg:gap-16">

    <!-- ============================================================ -->
    <!-- LEFT — identity rail (sticky on lg+, stacks first on mobile)   -->
    <!-- ============================================================ -->
    <div class="w-full lg:w-[380px] lg:min-w-[380px] lg:sticky lg:top-16 lg:self-start py-10 lg:py-16">

      <p class="rail-kicker mb-3">Human-centered AI · Feedback · Reliable agents</p>
      <p class="rail-name mb-1">Baixin Guo</p>
      <p class="font-mono text-[0.7rem] text-[var(--color-text-muted)] uppercase tracking-[0.1em] mb-5">Max · independent researcher</p>

      <h1 class="mb-5">
        {profile.headline}
      </h1>

      <p class="font-sans text-[0.95rem] text-[var(--color-text-dim)] leading-relaxed mb-4">
        {profile.profile}
      </p>

      <!-- Editorial visual (conceptual orientation, not a banner) -->
      <figure class="hidden sm:block mb-6">
        <img src={'/images/home-hero.png'} alt="Conceptual overview of human–AI decision calibration research" width="1200" height="500" loading="lazy" class="w-full h-auto rounded-lg border border-[var(--color-rule-light)]" />
      </figure>

      <p class="font-sans text-sm text-[var(--color-text-dim)] leading-relaxed mb-6">
        I am open to research collaboration and RA opportunities in human-centered AI, feedback learning, and agent evaluation.
      </p>

      <!-- Identity links -->
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-8 font-mono text-[0.75rem]">
        <a href="https://github.com/GBX-Max1220" target="_blank" rel="noopener" class="text-[var(--color-primary)] hover:text-[var(--color-primary-dim)] transition-colors">GitHub</a>
        <a href="/cv/" class="text-[var(--color-primary)] hover:text-[var(--color-primary-dim)] transition-colors">CV</a>
        <a href="mailto:gbx1220max@gmail.com" class="text-[var(--color-primary)] hover:text-[var(--color-primary-dim)] transition-colors">Email</a>
        <a href="https://www.linkedin.com/in/baixin-guo-681113285/" target="_blank" rel="noopener" class="text-[var(--color-text-muted)] hover:text-[var(--color-ink)] transition-colors">LinkedIn</a>
      </div>

      <a href="#research" class="link-arrow">Explore the research program ↓</a>
    </div>

    <!-- ============================================================ -->
    <!-- RIGHT — research agenda flow                                  -->
    <!-- ============================================================ -->
    <div class="flex-1 min-w-0 py-10 lg:py-16">

      <!-- RESEARCH QUESTION (short; full agenda lives on /research/) -->
      <section id="research" class="mb-14">
        <span class="section-kicker">Research question</span>
        <h2 class="mt-2 mb-2">From feedback to reliable decisions</h2>
        <p class="font-sans text-sm text-[var(--color-text-dim)] leading-relaxed mb-4">{profile.question}</p>
        <a href="/research/" class="link-arrow">Read the full research agenda →</a>
      </section>

      <!-- SELECTED CONTRIBUTIONS (public evidence) -->
      <SelectedContributions />

      <!-- SELECTED WORK -->
      <section id="work" class="mb-14">
        <span class="section-kicker">Selected work</span>
        <h2 class="mt-2 mb-5">Selected work</h2>

        <div class="space-y-5">
          {profile.collaborations.map(work => <article class="card-static"><h3 class="text-[1.1rem] mb-1.5">{work.title}</h3><p class="text-xs text-[var(--color-text-muted)] mb-2">{work.context}</p><p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-2">{work.summary}</p><p class="work-kind mb-2">{work.status}</p><a href={`/research/#${work.id}`} class="link-arrow">Contribution and scope →</a></article>)}
          {profile.projects.map(work => <article class="card-static"><h3 class="text-[1.1rem] mb-1.5">{work.title}</h3><p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-2">{work.summary}</p><p class="work-kind mb-2">{work.status}</p><a href={work.url} class="link-arrow">Explore the artifact →</a></article>)}
        </div>

        <div class="mt-5">
          <a href="/research/" class="link-arrow">View all research →</a>
        </div>
      </section>

      <!-- HOW I WORK (working research-selection discipline, not a formal methodology) -->
      <section id="process" class="mb-14">
        <span class="section-kicker">Research process</span>
        <h2 class="mt-2 mb-2">How I work</h2>
        <p class="font-sans text-sm text-[var(--color-text-dim)] leading-relaxed mb-4">I use a failure-first, repo-first workflow to decide which questions deserve further experiments.</p>
        <div class="space-y-0">
          <div class="arc-item"><span class="arc-index">01 · Observe the failure</span><p class="text-sm text-[var(--color-text-dim)] mt-1">Start from a concrete system behavior, an evaluation failure, or an implementation boundary — not from a novelty claim.</p></div>
          <div class="arc-item"><span class="arc-index">02 · Reduce and collide</span><p class="text-sm text-[var(--color-text-dim)] mt-1">Test whether the candidate mechanism reduces to adjacent theory or directly collides with prior work.</p></div>
          <div class="arc-item"><span class="arc-index">03 · Build only if it survives</span><p class="text-sm text-[var(--color-text-dim)] mt-1">Promote a question to a new experiment only when the mechanism remains distinct, testable, and supported by an observed phenomenon.</p></div>
        </div>
      </section>

      <!-- RECENT PUBLIC ACTIVITY -->
      <section id="latest" class="contribution-latest">
        <div class="flex items-end justify-between mb-4">
          <div>
            <span class="section-kicker">Dated evidence</span>
            <h2 class="mt-2">Recent activity</h2>
          </div>
          <a href="/contributions/" class="link-arrow">Full log →</a>
        </div>

        <ActivityLog />
      </section>

    </div>

  </div>
</div>

</BaseLayout>
