---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Blog" description="Research notes and essays — Baixin Guo">
  <div class="container-content py-16">
    <div class="max-w-2xl">

      <span class="section-label mb-4">Blog</span>
      <h1 class="mb-8">Blog</h1>

      <!-- Independently researched, interactive public essay. -->
      <section aria-labelledby="public-essays-heading" class="mb-12">
        <h2 id="public-essays-heading" class="font-sans text-[0.8rem] font-semibold text-[var(--color-text-dim)] uppercase tracking-wider mb-4">Public essays · 社会与技术</h2>
        <a href="/non-answers/" class="card group block">
          <p class="font-mono text-[0.6rem] text-[var(--color-text-muted)] mb-2">2026-10 · Interactive feature · 简 / 繁 / EN</p>
          <h3 class="font-display text-[1.15rem] text-[var(--color-ink)] group-hover:text-[var(--color-primary)] transition-colors mb-1" lang="zh-Hans">正确的废话 · The Language of Non-Answers</h3>
          <p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-3" lang="zh-Hans">基于2025年18份公开文本的探索性研究，分析政治套语、记者问答中的信息缺口与清楚回答的反例。包括原文、方法和可核查的数据。</p>
          <div class="flex gap-1.5"><span class="badge">Language & Politics</span><span class="badge">Public Evidence</span></div>
        </a>
      </section>

      <!-- Research Notes -->
      <h2 class="font-sans text-[0.8rem] font-semibold text-[var(--color-text-dim)] uppercase tracking-wider mb-4">Research Notes</h2>
      <div class="space-y-4 mb-12">
        <a href="/blog/precision-illusion-intro/" class="card group block">
          <p class="font-mono text-[0.6rem] text-[var(--color-text-muted)] mb-2">2026-07-01 · Historical research note</p>
          <h3 class="font-display text-[1.05rem] text-[var(--color-ink)] group-hover:text-[var(--color-primary)] transition-colors mb-1">
            Precision Illusion: A Framework for Studying Unsupported Numerical Specificity in AI
          </h3>
          <p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-3">
            An exploratory framework retained as research history; its measurement operationalisation has since been retired.
          </p>
          <div class="flex gap-1.5">
            <span class="badge">LLM Calibration</span>
            <span class="badge">Precision Illusion</span>
          </div>
        </a>
      </div>

            <!-- Essays -->
      <div class="space-y-4">
        <a href="/blog/building-tools-for-trust/" class="card group block">
          <p class="font-mono text-[0.6rem] text-[var(--color-text-muted)] mb-2">2026-06-15</p>
          <h3 class="font-display text-[1.05rem] text-[var(--color-ink)] group-hover:text-[var(--color-primary)] transition-colors mb-1">
            Building Tools, Not Just Papers: Why I Code
          </h3>
          <p class="text-sm text-[var(--color-text-dim)] leading-relaxed mb-3">
            Why I believe building functional systems alongside publishing papers is essential for trustworthy AI research.
          </p>
          <div class="flex gap-1.5">
            <span class="badge">Research Practice</span>
            <span class="badge">Open Science</span>
          </div>
        </a>
      </div>
        </a>
      </div>

    </div>
  </div>
</BaseLayout>
