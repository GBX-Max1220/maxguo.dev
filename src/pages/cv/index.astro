---
import BaseLayout from '../../layouts/BaseLayout.astro';
import profile from '../../data/research-profile.json';
import { siteUrl } from '../../config/site.mjs';

const pdfUrl = siteUrl('Baixin_Guo_CV.pdf');
---

<BaseLayout
  title="CV — Baixin (Max) Guo"
  description="Baixin (Max) Guo — Human-Centered AI, AI Evaluation & Learning, and Reliable AI Agents"
>
  <div class="container-content py-16">
    <div class="max-w-3xl">
      <div class="mb-10">
        <span class="section-label mb-4">CV</span>
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div>
            <h1 class="mb-2">Baixin (Max) Guo</h1>
            <p class="text-base text-[var(--color-text-dim)] mb-3">
              Human-Centered AI · AI Evaluation &amp; Learning · Reliable AI Agents
            </p>
          </div>
          <a class="btn btn-sm" href={pdfUrl} target="_blank" rel="noopener noreferrer">Download PDF</a>
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-2 text-sm text-[var(--color-text-dim)]">
          <a class="link" href="mailto:gbx1220max@gmail.com">gbx1220max@gmail.com</a>
          <a class="link" href="https://github.com/GBX-Max1220" target="_blank" rel="noopener noreferrer">GitHub</a>
          <span>China · Remote availability from Oct 2026</span>
        </div>
        <p class="text-xs text-[var(--color-text-muted)] mt-3">Canonical research-outreach CV · Updated October 2026</p>
      </div>

      <section class="mb-10">
        <h2 class="text-[1.3rem] mb-4">Research Profile</h2>
        <div class="card-static space-y-3">
          <p class="text-sm text-[var(--color-text-dim)] leading-relaxed">
            {profile.profile}
          </p>
          <p class="text-sm text-[var(--color-text-dim)] leading-relaxed">
            <strong class="text-[var(--color-ink)]">Research interests:</strong> {profile.interests}
          </p>
          <p class="text-sm text-[var(--color-text-dim)] leading-relaxed">
            <strong class="text-[var(--color-ink)]">Selected artifacts:</strong>
            <a class="link" href="https://github.com/GBX-Max1220/preference-modeling-diagnostics">Preference Modeling Diagnostics</a> ·
            <a class="link" href="https://github.com/GBX-Max1220/CheckMyCoach" target="_blank" rel="noopener noreferrer">CheckMyCoach</a>
            ·
            <a class="link" href="https://github.com/GBX-Max1220/evaluation-runtime" target="_blank" rel="noopener noreferrer">Evaluation Runtime</a>
          </p>
        </div>
      </section>

      <section class="mb-10">
        <h2 class="text-[1.3rem] mb-4">Selected Research &amp; Technical Experience</h2>
        <div class="space-y-4">
          {[...profile.collaborations, ...profile.projects, ...profile.additional.filter(work => work.id !== 'jev-tind')].map(work => <div class="card-static"><div class="flex items-start justify-between gap-4 flex-wrap mb-2"><div><h3 class="font-medium text-[var(--color-ink)]">{'url' in work ? <a class="link" href={work.url}>{work.title}</a> : work.title}</h3>{'context' in work && <p class="text-xs text-[var(--color-text-muted)]">{work.context}</p>}</div><span class="text-xs text-[var(--color-text-muted)]">{work.date}</span></div><p class="work-kind mb-2">{work.status}</p><ul class="text-sm text-[var(--color-text-dim)] space-y-1.5 list-disc pl-5">{work.bullets.map(item => <li>{item}</li>)}</ul></div>)}

          <div class="card-static">
            <div class="flex items-start justify-between gap-4 flex-wrap mb-2">
              <div>
                <h3 class="font-medium text-[var(--color-ink)]">Undergraduate Thesis — Evaluating Chinese LLMs on CBT-Bench</h3>
              </div>
              <span class="text-xs text-[var(--color-text-muted)]">2026</span>
            </div>
            <ul class="text-sm text-[var(--color-text-dim)] space-y-1.5 list-disc pl-5">
              <li>Designed a fixed zero-shot evaluation across five Chinese LLM services on 442 structured CBT-Bench examples; implemented batch API execution with checkpointing and retry logic.</li>
              <li>Reported exact match, partial-overlap, and sample-average F1 metrics while bounding claims to benchmark evidence rather than clinical or human-outcome validity.</li>
            </ul>
          </div>

          <div class="card-static">
            <div class="flex items-start justify-between gap-4 flex-wrap mb-2">
              <div>
                <h3 class="font-medium text-[var(--color-ink)]">Trojan Sports Research Lab, USC Marshall School of Business</h3>
                <p class="text-xs text-[var(--color-text-muted)]">Research collaboration · Supervisor: Prof. Lorena Martin</p>
              </div>
              <span class="text-xs text-[var(--color-text-muted)]">Mar 2025 – Mar 2026</span>
            </div>
            <ul class="text-sm text-[var(--color-text-dim)] space-y-1.5 list-disc pl-5">
              <li>Collected, cleaned, visualized, and analyzed multi-source baseball data for research on pitcher workload, pitch characteristics, and injury risk.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="mb-10">
        <h2 class="text-[1.3rem] mb-4">Education</h2>
        <div class="card-static">
          <div class="flex items-start justify-between gap-4 flex-wrap">
            <div>
              <h3 class="font-medium text-[var(--color-ink)]">Changchun Humanities and Sciences College</h3>
              <p class="text-sm text-[var(--color-text-dim)] mt-1">Bachelor’s degree in Applied Psychology</p>
            </div>
            <span class="text-xs text-[var(--color-text-muted)]">2022 – 2026</span>
          </div>
        </div>
      </section>

      <section>
        <h2 class="text-[1.3rem] mb-4">Technical &amp; Research Skills</h2>
        <div class="grid grid-cols-1 gap-3">
          <div class="card-static">
            <h3 class="font-mono text-[0.6rem] font-semibold text-[var(--color-primary)] uppercase tracking-wider mb-2">Programming / Engineering</h3>
            <p class="text-sm text-[var(--color-text-dim)]">Python; JavaScript/TypeScript; SQL/SQLite; Git/GitHub; pytest; CLI tooling; structured data pipelines</p>
          </div>
          <div class="card-static">
            <h3 class="font-mono text-[0.6rem] font-semibold text-[var(--color-gold)] uppercase tracking-wider mb-2">ML / AI</h3>
            <p class="text-sm text-[var(--color-text-dim)]">LLM/API pipelines; LLM evaluation; agent prototyping; supervised ML workflows; contextual bandits (LinUCB)</p>
          </div>
          <div class="card-static">
            <h3 class="font-mono text-[0.6rem] font-semibold text-[var(--color-secondary)] uppercase tracking-wider mb-2">Research / Measurement</h3>
            <p class="text-sm text-[var(--color-text-dim)]">Experimental design; psychometrics; inter-rater reliability; behavioral study design; statistical analysis</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
